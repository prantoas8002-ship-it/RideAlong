{
  "_comment": "PLACEHOLDER ONLY. Download the real file from Firebase Console > Project settings > Your apps > Android (package com.example.ridealong) and save it as app/google-services.json. Never commit the real file.",
  "project_info": {
    "project_number": "YOUR_PROJECT_NUMBER",
    "project_id": "your-firebase-project-id",
    "storage_bucket": "your-firebase-project-id.appspot.com"
  },
  "client": [
    {
      "client_info": {
        "mobilesdk_app_id": "1:YOUR_PROJECT_NUMBER:android:YOUR_APP_HASH",
        "android_client_info": { "package_name": "com.example.ridealong" }
      },
      "oauth_client": [
        { "client_id": "YOUR_WEB_CLIENT_ID.apps.googleusercontent.com", "client_type": 3 }
      ],
      "api_key": [ { "current_key": "YOUR_ANDROID_API_KEY" } ],
      "services": { "appinvite_service": { "other_platform_oauth_client": [] } }
    }
  ],
  "configuration_version": "1"
}
