<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <TextView
        android:id="@+id/banner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/ra_surface"
        android:drawablePadding="@dimen/space_s"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:maxLines="1"
        android:paddingHorizontal="@dimen/screen_padding"
        android:paddingVertical="@dimen/space_s"
        android:textAppearance="@style/TextAppearance.RideAlong.Caption"
        app:drawableStartCompat="@drawable/ic_route"
        app:drawableTint="@color/ra_text_secondary" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/ra_outline" />

    <!-- A group video call is running for this ride: tap to join -->
    <LinearLayout
        android:id="@+id/group_call_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/ra_primary"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/screen_padding"
        android:paddingVertical="@dimen/space_xs"
        android:visibility="gone">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:drawablePadding="@dimen/space_s"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:maxLines="1"
            android:text="@string/group_call_banner"
            android:textAppearance="@style/TextAppearance.RideAlong.BodyLarge"
            android:textColor="@color/ra_white"
            app:drawableStartCompat="@drawable/ic_videocam"
            app:drawableTint="@color/ra_white" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/group_call_join"
            style="@style/Widget.RideAlong.Button.Small"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:backgroundTint="#16A34A"
            android:text="@string/group_call_join"
            android:textColor="@color/ra_white" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/messages"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingHorizontal="@dimen/space_m"
            android:paddingVertical="@dimen/space_m" />

        <com.example.ridealong.ui.common.StateView
            android:id="@+id/state"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </FrameLayout>

    <TextView
        android:id="@+id/closed_note"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/ra_surface_variant"
        android:gravity="center"
        android:padding="@dimen/space_m"
        android:text="@string/chat_ride_closed"
        android:textAppearance="@style/TextAppearance.RideAlong.Caption"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/input_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/ra_surface"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="@dimen/space_s">

        <EditText
            android:id="@+id/input"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_input_bar"
            android:hint="@string/hint_message"
            android:importantForAutofill="no"
            android:inputType="textMultiLine|textCapSentences"
            android:maxLength="2000"
            android:maxLines="4"
            android:minHeight="48dp"
            android:paddingHorizontal="@dimen/space_l"
            android:paddingVertical="@dimen/space_s"
            android:textAppearance="@style/TextAppearance.RideAlong.BodyLarge" />

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/send"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_s"
            android:contentDescription="@string/cd_send"
            app:elevation="0dp"
            app:fabSize="mini"
            app:srcCompat="@drawable/ic_send" />
    </LinearLayout>
</LinearLayout>