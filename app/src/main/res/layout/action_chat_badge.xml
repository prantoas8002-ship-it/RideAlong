<?xml version="1.0" encoding="utf-8"?>
<!-- Home toolbar action: chat icon with an unread badge. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="48dp"
    android:layout_height="48dp"
    android:background="?attr/selectableItemBackgroundBorderless"
    android:clickable="true"
    android:contentDescription="@string/cd_open_chats"
    android:focusable="true">

    <ImageView
        android:layout_width="@dimen/icon_l"
        android:layout_height="@dimen/icon_l"
        android:layout_gravity="center"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_chat"
        app:tint="@color/ra_text" />

    <TextView
        android:id="@+id/chat_badge"
        android:layout_width="wrap_content"
        android:layout_height="18dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="6dp"
        android:layout_marginEnd="4dp"
        android:background="@drawable/bg_badge"
        android:gravity="center"
        android:minWidth="18dp"
        android:paddingHorizontal="4dp"
        android:textColor="@color/ra_white"
        android:textSize="10sp"
        android:textStyle="bold"
        android:visibility="gone" />
</FrameLayout>