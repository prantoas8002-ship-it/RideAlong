<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:minHeight="56dp"
    android:orientation="horizontal"
    android:paddingHorizontal="@dimen/space_l">

    <ImageView
        android:id="@+id/row_icon"
        android:layout_width="@dimen/icon_l"
        android:layout_height="@dimen/icon_l"
        android:importantForAccessibility="no"
        app:tint="@color/ra_primary" />

    <TextView
        android:id="@+id/row_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_l"
        android:layout_weight="1"
        android:textAppearance="@style/TextAppearance.RideAlong.BodyLarge" />

    <ImageView
        android:layout_width="@dimen/icon_m"
        android:layout_height="@dimen/icon_m"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_arrow_forward"
        app:tint="@color/ra_text_tertiary" />
</LinearLayout>