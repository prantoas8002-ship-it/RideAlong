<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/ride_card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/screen_padding"
    android:layout_marginVertical="@dimen/space_s"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/space_l">

        <!-- Header: poster on the left, price column on the right (never squeezed) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/owner_avatar"
                style="@style/Widget.RideAlong.Avatar"
                android:layout_width="@dimen/avatar_s"
                android:layout_height="@dimen/avatar_s"
                android:contentDescription="@string/cd_avatar" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_m"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/owner_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textAppearance="@style/TextAppearance.RideAlong.TitleMedium" />

                <include
                    android:id="@+id/owner_rating"
                    layout="@layout/component_rating_summary" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_s"
                android:gravity="end"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/cost"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:textAppearance="@style/TextAppearance.RideAlong.TitleLarge"
                    android:textColor="@color/ra_primary" />

                <TextView
                    android:id="@+id/cost_unit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:text="@string/per_person"
                    android:textAppearance="@style/TextAppearance.RideAlong.Caption" />
            </LinearLayout>
        </LinearLayout>

        <!-- Route -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_m"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="12dp"
                android:layout_height="match_parent"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingVertical="5dp">

                <View
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:background="@drawable/dot_pickup" />

                <View
                    android:layout_width="2dp"
                    android:layout_height="0dp"
                    android:layout_marginVertical="2dp"
                    android:layout_weight="1"
                    android:background="@color/ra_outline_strong" />

                <View
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:background="@drawable/dot_drop" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_m"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/pickup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textAppearance="@style/TextAppearance.RideAlong.BodyLarge" />

                <TextView
                    android:id="@+id/drop"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_m"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textAppearance="@style/TextAppearance.RideAlong.BodyLarge" />
            </LinearLayout>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="@dimen/space_m"
            android:background="@color/ra_outline" />

        <!-- Footer: time takes the remaining width and ellipsizes; seats and badge stay intact -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/time"
                style="@style/RideAlong.InfoText"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                app:drawableStartCompat="@drawable/ic_schedule" />

            <TextView
                android:id="@+id/seats"
                style="@style/RideAlong.InfoText"
                android:layout_marginStart="@dimen/space_m"
                android:maxLines="1"
                app:drawableStartCompat="@drawable/ic_seat" />

            <TextView
                android:id="@+id/badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_s"
                android:background="@drawable/bg_pill_primary"
                android:maxLines="1"
                android:paddingHorizontal="@dimen/space_s"
                android:paddingVertical="@dimen/space_xxs"
                android:textAppearance="@style/TextAppearance.RideAlong.Caption"
                android:textColor="@color/ra_on_primary_container"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/extra"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_s"
            android:ellipsize="end"
            android:maxLines="2"
            android:textAppearance="@style/TextAppearance.RideAlong.Caption"
            android:visibility="gone" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
