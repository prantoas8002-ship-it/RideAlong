<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ra_background"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize" />

        <TextView
            android:id="@+id/offline_banner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_offline_banner"
            android:drawablePadding="@dimen/space_s"
            android:gravity="center_vertical"
            android:paddingHorizontal="@dimen/screen_padding"
            android:paddingVertical="@dimen/space_s"
            android:text="@string/offline_banner"
            android:textAppearance="@style/TextAppearance.RideAlong.Caption"
            android:textColor="@color/ra_inverse_on_surface"
            android:visibility="gone"
            app:drawableStartCompat="@drawable/ic_wifi_off"
            app:drawableTint="@color/ra_inverse_on_surface" />

        <!-- Driven by SystemEventReceiver: battery low, Battery Saver, airplane mode. -->
        <TextView
            android:id="@+id/system_banner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_offline_banner"
            android:drawablePadding="@dimen/space_s"
            android:gravity="center_vertical"
            android:paddingHorizontal="@dimen/screen_padding"
            android:paddingVertical="@dimen/space_s"
            android:textAppearance="@style/TextAppearance.RideAlong.Caption"
            android:textColor="@color/ra_inverse_on_surface"
            android:visibility="gone"
            app:drawableTint="@color/ra_inverse_on_surface" />

        <androidx.fragment.app.FragmentContainerView
            android:id="@+id/nav_host"
            android:name="androidx.navigation.fragment.NavHostFragment"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            app:defaultNavHost="true"
            app:navGraph="@navigation/nav_main" />

        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/bottom_nav"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:menu="@menu/bottom_nav" />
    </LinearLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>