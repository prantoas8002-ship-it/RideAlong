<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="start"
    android:orientation="vertical"
    android:paddingTop="@dimen/space_xs"
    android:paddingStart="@dimen/space_xxs"
    android:paddingEnd="56dp"
    android:paddingBottom="@dimen/space_xs">

    <TextView
        android:id="@+id/sender"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_s"
        android:layout_marginBottom="2dp"
        android:textAppearance="@style/TextAppearance.RideAlong.Caption"
        android:textColor="@color/ra_secondary"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_bubble_in"
        android:paddingHorizontal="@dimen/space_m"
        android:paddingVertical="@dimen/space_s"
        android:textAppearance="@style/TextAppearance.RideAlong.BodyLarge"
        android:textIsSelectable="true" />

    <TextView
        android:id="@+id/time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_s"
        android:layout_marginTop="2dp"
        android:textAppearance="@style/TextAppearance.RideAlong.Caption"
        android:textColor="@color/ra_text_tertiary"
        android:textSize="11sp" />
</LinearLayout>