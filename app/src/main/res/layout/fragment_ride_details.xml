<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/screen_padding"
            android:paddingBottom="@dimen/space_xxl">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/map_height"
                android:background="@drawable/bg_map_card">

                <FrameLayout
                    android:id="@+id/map_container"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_l"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="@dimen/space_m"
                    android:paddingVertical="@dimen/space_xs"
                    android:textAppearance="@style/TextAppearance.RideAlong.Caption"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/cached"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_s"
                    android:background="@drawable/bg_pill"
                    android:paddingHorizontal="@dimen/space_m"
                    android:paddingVertical="@dimen/space_xs"
                    android:text="@string/cached_label"
                    android:textAppearance="@style/TextAppearance.RideAlong.Caption"
                    android:visibility="gone" />

                <Space
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/cost"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.RideAlong.TitleLarge"
                    android:textColor="@color/ra_primary" />
            </LinearLayout>

            <TextView
                android:id="@+id/departure"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                android:textAppearance="@style/TextAppearance.RideAlong.Headline" />

            <!-- Route -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_m">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_l">

                    <TextView
                        android:id="@+id/pickup"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:drawablePadding="@dimen/space_m"
                        android:textAppearance="@style/TextAppearance.RideAlong.BodyLarge"
                        app:drawableStartCompat="@drawable/dot_pickup" />

                    <TextView
                        android:id="@+id/drop"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_m"
                        android:drawablePadding="@dimen/space_m"
                        android:textAppearance="@style/TextAppearance.RideAlong.BodyLarge"
                        app:drawableStartCompat="@drawable/dot_drop" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginVertical="@dimen/space_m"
                        android:background="@color/ra_outline" />

                    <com.google.android.material.chip.ChipGroup
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chip_seats"
                            style="@style/Widget.Material3.Chip.Assist"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:chipIcon="@drawable/ic_seat" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chip_transport"
                            style="@style/Widget.Material3.Chip.Assist"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:chipIcon="@drawable/ic_car" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chip_detour"
                            style="@style/Widget.Material3.Chip.Assist"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:chipIcon="@drawable/ic_route" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chip_distance"
                            style="@style/Widget.Material3.Chip.Assist"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:chipIcon="@drawable/ic_navigation" />
                    </com.google.android.material.chip.ChipGroup>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Match (from Discover search) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/match_card"
                style="@style/Widget.RideAlong.Card.Tinted"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_m"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_l">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/details_your_match"
                        android:textAppearance="@style/TextAppearance.RideAlong.Overline"
                        android:textColor="@color/ra_primary" />

                    <TextView
                        android:id="@+id/match_info"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_xs"
                        android:textAppearance="@style/TextAppearance.RideAlong.BodyLarge"
                        android:textColor="@color/ra_on_primary_container" />

                    <TextView
                        android:id="@+id/match_share"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_xs"
                        android:textAppearance="@style/TextAppearance.RideAlong.Caption"
                        android:textColor="@color/ra_on_primary_container" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Poster -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xl"
                android:text="@string/posted_by"
                android:textAppearance="@style/TextAppearance.RideAlong.Overline" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/owner_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="@dimen/space_l">

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/owner_avatar"
                        style="@style/Widget.RideAlong.Avatar"
                        android:layout_width="@dimen/avatar_m"
                        android:layout_height="@dimen/avatar_m"
                        android:contentDescription="@string/cd_avatar" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_m"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/owner_name"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textAppearance="@style/TextAppearance.RideAlong.TitleMedium" />

                        <TextView
                            android:id="@+id/owner_org"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textAppearance="@style/TextAppearance.RideAlong.Caption"
                            android:visibility="gone" />

                        <include
                            android:id="@+id/owner_rating"
                            layout="@layout/component_rating_summary" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="@dimen/icon_l"
                        android:layout_height="@dimen/icon_l"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_arrow_forward"
                        app:tint="@color/ra_text_tertiary" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/comment_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xl"
                android:text="@string/details_comment"
                android:textAppearance="@style/TextAppearance.RideAlong.Overline" />

            <TextView
                android:id="@+id/comment"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:textAppearance="@style/TextAppearance.RideAlong.BodyLarge" />

            <!-- Participants (members only) -->
            <TextView
                android:id="@+id/participants_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xl"
                android:text="@string/details_participants"
                android:textAppearance="@style/TextAppearance.RideAlong.Overline" />

            <LinearLayout
                android:id="@+id/participants"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                android:orientation="vertical" />

            <!-- Status note + actions -->
            <TextView
                android:id="@+id/note"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xl"
                android:background="@drawable/bg_pill_primary"
                android:gravity="center"
                android:padding="@dimen/space_m"
                android:textAppearance="@style/TextAppearance.RideAlong.Body"
                android:textColor="@color/ra_on_primary_container"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/primary_action"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_l"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/member_actions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_m"
                android:orientation="horizontal"
                android:visibility="gone">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/chat"
                    style="@style/Widget.RideAlong.Button.Tonal"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/action_open_chat"
                    app:icon="@drawable/ic_chat" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/track"
                    style="@style/Widget.RideAlong.Button.Tonal"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_s"
                    android:layout_weight="1"
                    android:text="@string/action_track"
                    app:icon="@drawable/ic_map" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/sos"
                    style="@style/Widget.RideAlong.Button.Tonal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_s"
                    android:text="@string/action_sos"
                    android:textColor="@color/ra_error"
                    app:backgroundTint="@color/ra_error_container"
                    app:icon="@drawable/ic_warning"
                    app:iconTint="@color/ra_error" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/secondary_action"
                style="@style/Widget.RideAlong.Button.Outlined"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_m"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/danger_action"
                style="@style/Widget.RideAlong.Button.Text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                android:textColor="@color/ra_error"
                android:visibility="gone" />

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/progress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_m"
                android:indeterminate="true"
                android:visibility="invisible" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <com.example.ridealong.ui.common.StateView
        android:id="@+id/state"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/ra_background" />
</FrameLayout>