<?xml version="1.0" encoding="utf-8"?>
<!-- RecyclerView row for a direct chat. ConstraintLayout: one flat hierarchy instead of nested LinearLayouts. -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:paddingHorizontal="@dimen/screen_padding"
    android:paddingVertical="@dimen/space_m">

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/avatar"
        style="@style/Widget.RideAlong.Avatar"
        android:layout_width="@dimen/avatar_m"
        android:layout_height="@dimen/avatar_m"
        android:contentDescription="@string/cd_avatar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_m"
        android:ellipsize="end"
        android:maxLines="1"
        android:textAppearance="@style/TextAppearance.RideAlong.TitleMedium"
        app:layout_constraintEnd_toStartOf="@id/time"
        app:layout_constraintStart_toEndOf="@id/avatar"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        app:layout_constraintBottom_toTopOf="@id/ride" />

    <TextView
        android:id="@+id/time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_s"
        android:textAppearance="@style/TextAppearance.RideAlong.Caption"
        app:layout_constraintBaseline_toBaselineOf="@id/name"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/ride"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:drawablePadding="@dimen/space_xs"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:maxLines="1"
        android:textAppearance="@style/TextAppearance.RideAlong.Caption"
        android:textColor="@color/ra_secondary"
        app:drawableStartCompat="@drawable/ic_flag"
        app:drawableTint="@color/ra_secondary"
        app:layout_constraintBottom_toTopOf="@id/last_message"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@id/name"
        app:layout_constraintTop_toBottomOf="@id/name" />

    <TextView
        android:id="@+id/last_message"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:textAppearance="@style/TextAppearance.RideAlong.Body"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/unread_dot"
        app:layout_constraintStart_toStartOf="@id/name"
        app:layout_constraintTop_toBottomOf="@id/ride" />

    <View
        android:id="@+id/unread_dot"
        android:layout_width="10dp"
        android:layout_height="10dp"
        android:layout_marginStart="@dimen/space_s"
        android:background="@drawable/bg_badge"
        app:layout_constraintBottom_toBottomOf="@id/last_message"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/last_message" />
</androidx.constraintlayout.widget.ConstraintLayout>
