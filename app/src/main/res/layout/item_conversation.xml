<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="@dimen/screen_padding"
    android:paddingVertical="@dimen/space_m">

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/avatar"
        style="@style/Widget.RideAlong.Avatar"
        android:layout_width="@dimen/avatar_m"
        android:layout_height="@dimen/avatar_m"
        android:contentDescription="@string/cd_avatar" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_m"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.RideAlong.TitleMedium" />

            <TextView
                android:id="@+id/time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_s"
                android:textAppearance="@style/TextAppearance.RideAlong.Caption" />
        </LinearLayout>

        <TextView
            android:id="@+id/ride"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:drawablePadding="@dimen/space_xs"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.RideAlong.Caption"
            android:textColor="@color/ra_secondary"
            app:drawableStartCompat="@drawable/ic_flag"
            app:drawableTint="@color/ra_secondary" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/last_message"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.RideAlong.Body" />

            <View
                android:id="@+id/unread_dot"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:layout_marginStart="@dimen/space_s"
                android:background="@drawable/bg_badge" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>