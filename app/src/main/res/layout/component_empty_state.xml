<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/empty_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="@dimen/space_xxl">

    <ImageView
        android:id="@+id/empty_icon"
        android:layout_width="88dp"
        android:layout_height="88dp"
        android:background="@drawable/bg_circle_primary_container"
        android:importantForAccessibility="no"
        android:padding="24dp"
        android:src="@drawable/ic_car"
        android:tint="@color/ra_primary" />

    <TextView
        android:id="@+id/empty_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_l"
        android:gravity="center"
        android:textAppearance="@style/TextAppearance.RideAlong.TitleMedium" />

    <TextView
        android:id="@+id/empty_message"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_xs"
        android:gravity="center"
        android:maxWidth="320dp"
        android:textAppearance="@style/TextAppearance.RideAlong.Body" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/empty_action"
        style="@style/Widget.RideAlong.Button.Tonal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_l"
        android:visibility="gone" />
</LinearLayout>