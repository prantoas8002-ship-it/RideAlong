<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/space_xl"
    android:paddingTop="@dimen/space_m">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/report_reason"
        android:textAppearance="@style/TextAppearance.RideAlong.Caption" />

    <RadioGroup
        android:id="@+id/reasons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <RadioButton
            android:id="@+id/reason_unsafe"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="@string/report_reason_unsafe" />

        <RadioButton
            android:id="@+id/reason_harassment"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/report_reason_harassment" />

        <RadioButton
            android:id="@+id/reason_noshow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/report_reason_noshow" />

        <RadioButton
            android:id="@+id/reason_fake"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/report_reason_fake" />

        <RadioButton
            android:id="@+id/reason_other"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/report_reason_other" />
    </RadioGroup>

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_s"
        android:hint="@string/hint_report_details">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/details"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textMultiLine|textCapSentences"
            android:maxLength="1000" />
    </com.google.android.material.textfield.TextInputLayout>
</LinearLayout>