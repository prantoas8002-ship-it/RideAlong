<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_splash"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="@dimen/space_xxl">

    <ImageView
        android:id="@+id/logo"
        android:layout_width="112dp"
        android:layout_height="112dp"
        android:background="@drawable/bg_circle_white_translucent"
        android:importantForAccessibility="no"
        android:padding="12dp"
        android:src="@drawable/ic_logo" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_l"
        android:text="@string/app_name"
        android:textAppearance="@style/TextAppearance.RideAlong.Display"
        android:textColor="@color/ra_white" />

    <TextView
        android:id="@+id/tagline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_xs"
        android:text="@string/tagline"
        android:textAppearance="@style/TextAppearance.RideAlong.BodyLarge"
        android:textColor="#DDFFFFFF" />

    <com.google.android.material.progressindicator.CircularProgressIndicator
        android:id="@+id/progress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_xxl"
        android:indeterminate="true"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        app:indicatorColor="@color/ra_white" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/config_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_xxl"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/space_xl">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/firebase_missing_title"
                android:textAppearance="@style/TextAppearance.RideAlong.TitleMedium" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                android:text="@string/firebase_missing_body"
                android:textAppearance="@style/TextAppearance.RideAlong.Body" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</LinearLayout>