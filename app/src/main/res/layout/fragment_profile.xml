<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/screen_padding"
            android:paddingBottom="@dimen/space_xxl">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingTop="@dimen/space_m">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/avatar"
                    style="@style/Widget.RideAlong.Avatar"
                    android:layout_width="@dimen/avatar_l"
                    android:layout_height="@dimen/avatar_l"
                    android:contentDescription="@string/cd_avatar" />

                <TextView
                    android:id="@+id/name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_m"
                    android:textAppearance="@style/TextAppearance.RideAlong.Headline" />

                <TextView
                    android:id="@+id/organization"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:drawablePadding="@dimen/space_xs"
                    android:gravity="center_vertical"
                    android:textAppearance="@style/TextAppearance.RideAlong.Body"
                    android:visibility="gone"
                    app:drawableStartCompat="@drawable/ic_school"
                    app:drawableTint="@color/ra_text_secondary" />

                <TextView
                    android:id="@+id/member_since"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xxs"
                    android:textAppearance="@style/TextAppearance.RideAlong.Caption" />

                <TextView
                    android:id="@+id/cached"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_s"
                    android:background="@drawable/bg_pill"
                    android:paddingHorizontal="@dimen/space_m"
                    android:paddingVertical="@dimen/space_xs"
                    android:text="@string/cached_data_notice"
                    android:textAppearance="@style/TextAppearance.RideAlong.Caption"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- Stats -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xl"
                android:orientation="horizontal">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="@dimen/space_m">

                        <TextView
                            android:id="@+id/stat_rating"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:drawablePadding="@dimen/space_xxs"
                            android:gravity="center_vertical"
                            android:textAppearance="@style/TextAppearance.RideAlong.TitleLarge"
                            app:drawableStartCompat="@drawable/ic_star"
                            app:drawableTint="@color/ra_star" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/profile_rating"
                            android:textAppearance="@style/TextAppearance.RideAlong.Caption" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_s"
                    android:layout_weight="1">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="@dimen/space_m">

                        <TextView
                            android:id="@+id/stat_completed"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textAppearance="@style/TextAppearance.RideAlong.TitleLarge" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:text="@string/profile_completed_rides"
                            android:textAppearance="@style/TextAppearance.RideAlong.Caption" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_s"
                    android:layout_weight="1">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="@dimen/space_m">

                        <TextView
                            android:id="@+id/stat_reviews"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textAppearance="@style/TextAppearance.RideAlong.TitleLarge" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/profile_reviews"
                            android:textAppearance="@style/TextAppearance.RideAlong.Caption" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- Own profile shortcuts -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/own_menu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_l"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <include android:id="@+id/row_edit" layout="@layout/item_menu_row" />
                    <include android:id="@+id/row_history" layout="@layout/item_menu_row" />
                    <include android:id="@+id/row_sos" layout="@layout/item_menu_row" />
                    <include android:id="@+id/row_settings" layout="@layout/item_menu_row" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xl"
                android:text="@string/profile_reviews"
                android:textAppearance="@style/TextAppearance.RideAlong.Overline" />

            <LinearLayout
                android:id="@+id/reviews"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/reviews_empty"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                android:text="@string/profile_reviews_empty"
                android:textAppearance="@style/TextAppearance.RideAlong.Body"
                android:visibility="gone" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <com.example.ridealong.ui.common.StateView
        android:id="@+id/state"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/ra_background" />
</FrameLayout>