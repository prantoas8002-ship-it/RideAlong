<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Shapes -->
    <style name="ShapeAppearance.RideAlong.Small" parent="ShapeAppearance.Material3.SmallComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/radius_s</item>
    </style>
    <style name="ShapeAppearance.RideAlong.Medium" parent="ShapeAppearance.Material3.MediumComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/radius_m</item>
    </style>
    <style name="ShapeAppearance.RideAlong.Large" parent="ShapeAppearance.Material3.LargeComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/radius_xl</item>
    </style>
    <style name="ShapeAppearance.RideAlong.Circle" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <!-- Typography scale -->
    <style name="TextAppearance.RideAlong.Display" parent="TextAppearance.Material3.HeadlineLarge">
        <item name="android:textSize">30sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/ra_text</item>
        <item name="android:letterSpacing">-0.01</item>
    </style>
    <style name="TextAppearance.RideAlong.Headline" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:textSize">24sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/ra_text</item>
    </style>
    <style name="TextAppearance.RideAlong.TitleLarge" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/ra_text</item>
    </style>
    <style name="TextAppearance.RideAlong.TitleMedium" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/ra_text</item>
    </style>
    <style name="TextAppearance.RideAlong.BodyLarge" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/ra_text</item>
    </style>
    <style name="TextAppearance.RideAlong.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/ra_text_secondary</item>
    </style>
    <style name="TextAppearance.RideAlong.Caption" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/ra_text_secondary</item>
    </style>
    <style name="TextAppearance.RideAlong.Label" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.01</item>
    </style>
    <style name="TextAppearance.RideAlong.Overline" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textColor">@color/ra_text_tertiary</item>
    </style>

    <!-- Widgets -->
    <style name="Widget.RideAlong.Card" parent="Widget.Material3.CardView.Outlined">
        <item name="cardBackgroundColor">@color/ra_surface</item>
        <item name="strokeColor">@color/ra_outline</item>
        <item name="strokeWidth">@dimen/stroke</item>
        <item name="cardElevation">@dimen/card_elevation</item>
        <item name="shapeAppearance">@style/ShapeAppearance.RideAlong.Large</item>
    </style>
    <style name="Widget.RideAlong.Card.Tinted" parent="Widget.RideAlong.Card">
        <item name="cardBackgroundColor">@color/ra_primary_container</item>
        <item name="strokeWidth">0dp</item>
    </style>

    <style name="Widget.RideAlong.TextInput" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">@dimen/radius_m</item>
        <item name="boxCornerRadiusTopEnd">@dimen/radius_m</item>
        <item name="boxCornerRadiusBottomStart">@dimen/radius_m</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/radius_m</item>
        <item name="boxStrokeColor">@color/ra_primary</item>
        <item name="boxBackgroundColor">@color/ra_surface</item>
    </style>

    <!-- Buttons: one consistent system. Single line + ellipsis so labels never clip or wrap. -->
    <style name="Widget.RideAlong.Button" parent="Widget.Material3.Button">
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:textAppearance">@style/TextAppearance.RideAlong.Label</item>
        <item name="shapeAppearance">@style/ShapeAppearance.RideAlong.Medium</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
        <item name="android:paddingStart">@dimen/space_l</item>
        <item name="android:paddingEnd">@dimen/space_l</item>
        <item name="iconSize">18dp</item>
        <item name="iconPadding">@dimen/space_s</item>
        <item name="iconGravity">textStart</item>
    </style>
    <style name="Widget.RideAlong.Button.Small" parent="Widget.RideAlong.Button">
        <item name="android:minHeight">@dimen/button_height_small</item>
        <item name="android:textSize">13sp</item>
        <item name="android:paddingStart">@dimen/space_m</item>
        <item name="android:paddingEnd">@dimen/space_m</item>
    </style>
    <style name="Widget.RideAlong.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:textAppearance">@style/TextAppearance.RideAlong.Label</item>
        <item name="shapeAppearance">@style/ShapeAppearance.RideAlong.Medium</item>
        <item name="strokeColor">@color/ra_outline_strong</item>
        <item name="android:textColor">@color/btn_primary_fg</item>
        <item name="iconTint">@color/btn_primary_fg</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
        <item name="iconSize">18dp</item>
        <item name="iconPadding">@dimen/space_s</item>
        <item name="iconGravity">textStart</item>
    </style>
    <style name="Widget.RideAlong.Button.Outlined.Small" parent="Widget.RideAlong.Button.Outlined">
        <item name="android:minHeight">@dimen/button_height_small</item>
        <item name="android:textSize">13sp</item>
        <item name="android:paddingStart">@dimen/space_m</item>
        <item name="android:paddingEnd">@dimen/space_m</item>
    </style>
    <style name="Widget.RideAlong.Button.Outlined.Danger" parent="Widget.RideAlong.Button.Outlined">
        <item name="strokeColor">@color/ra_error</item>
        <item name="android:textColor">@color/btn_danger_fg</item>
        <item name="iconTint">@color/btn_danger_fg</item>
        <item name="rippleColor">@color/ra_error_container</item>
    </style>
    <!-- Secondary actions: light blue (matches the brand) instead of Material's default purple tonal. -->
    <style name="Widget.RideAlong.Button.Tonal" parent="Widget.Material3.Button.TonalButton">
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:textAppearance">@style/TextAppearance.RideAlong.Label</item>
        <item name="shapeAppearance">@style/ShapeAppearance.RideAlong.Medium</item>
        <item name="backgroundTint">@color/btn_tonal_bg</item>
        <item name="android:textColor">@color/btn_tonal_fg</item>
        <item name="iconTint">@color/btn_tonal_fg</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
        <item name="iconSize">18dp</item>
        <item name="iconPadding">@dimen/space_s</item>
        <item name="iconGravity">textStart</item>
    </style>
    <style name="Widget.RideAlong.Button.Tonal.Small" parent="Widget.RideAlong.Button.Tonal">
        <item name="android:minHeight">@dimen/button_height_small</item>
        <item name="android:textSize">13sp</item>
        <item name="android:paddingStart">@dimen/space_m</item>
        <item name="android:paddingEnd">@dimen/space_m</item>
    </style>
    <!-- Equal-width tiles with the icon above a short label (Chat / Live map / SOS). -->
    <style name="Widget.RideAlong.Button.Tile" parent="Widget.RideAlong.Button.Tonal">
        <item name="android:minHeight">72dp</item>
        <item name="android:textSize">12sp</item>
        <item name="iconGravity">top</item>
        <item name="iconSize">22dp</item>
        <item name="iconPadding">@dimen/space_xs</item>
        <item name="android:paddingStart">@dimen/space_xs</item>
        <item name="android:paddingEnd">@dimen/space_xs</item>
        <item name="android:paddingTop">@dimen/space_s</item>
        <item name="android:paddingBottom">@dimen/space_s</item>
    </style>
    <style name="Widget.RideAlong.Button.Tile.Danger" parent="Widget.RideAlong.Button.Tile">
        <item name="backgroundTint">@color/ra_error_container</item>
        <item name="android:textColor">@color/btn_danger_fg</item>
        <item name="iconTint">@color/btn_danger_fg</item>
    </style>
    <style name="Widget.RideAlong.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:textAppearance">@style/TextAppearance.RideAlong.Label</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
        <item name="iconSize">18dp</item>
    </style>
    <style name="Widget.RideAlong.Button.Danger" parent="Widget.RideAlong.Button">
        <item name="backgroundTint">@color/ra_error</item>
    </style>
    <style name="Widget.RideAlong.Button.Stepper" parent="Widget.Material3.Button.IconButton.Outlined">
        <item name="iconTint">@color/btn_primary_fg</item>
        <item name="strokeColor">@color/ra_outline_strong</item>
    </style>

    <style name="Widget.RideAlong.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="android:background">@color/ra_background</item>
        <item name="titleTextAppearance">@style/TextAppearance.RideAlong.TitleLarge</item>
    </style>

    <style name="Widget.RideAlong.BottomNav" parent="Widget.Material3.BottomNavigationView">
        <item name="android:background">@color/ra_surface</item>
        <item name="itemActiveIndicatorStyle">@style/Widget.RideAlong.BottomNav.Indicator</item>
        <item name="labelVisibilityMode">labeled</item>
    </style>
    <style name="Widget.RideAlong.BottomNav.Indicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/ra_primary_container</item>
    </style>

    <style name="Widget.RideAlong.Chip" parent="Widget.Material3.Chip.Filter">
        <item name="chipBackgroundColor">@color/chip_background</item>
        <item name="chipStrokeColor">@color/ra_outline</item>
    </style>

    <style name="Widget.RideAlong.BottomSheet" parent="Widget.Material3.BottomSheet">
        <item name="shapeAppearance">@style/ShapeAppearance.RideAlong.Large</item>
        <item name="backgroundTint">@color/ra_surface</item>
    </style>

    <style name="Widget.RideAlong.Avatar" parent="">
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.RideAlong.Circle</item>
        <item name="android:scaleType">centerCrop</item>
        <item name="android:background">@color/ra_primary_container</item>
    </style>

    <style name="Widget.RideAlong.RatingBar.Small" parent="Widget.AppCompat.RatingBar.Small">
        <item name="android:progressTint">@color/ra_star</item>
        <item name="android:secondaryProgressTint">@color/ra_star</item>
        <item name="android:progressBackgroundTint">@color/ra_outline_strong</item>
    </style>
    <style name="Widget.RideAlong.RatingBar.Large" parent="Widget.AppCompat.RatingBar">
        <item name="android:progressTint">@color/ra_star</item>
        <item name="android:progressBackgroundTint">@color/ra_outline_strong</item>
    </style>

    <!-- Small info row: icon + text -->
    <style name="RideAlong.InfoText" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:drawablePadding">@dimen/space_xs</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:textAppearance">@style/TextAppearance.RideAlong.Caption</item>
        <item name="drawableTint">@color/ra_text_secondary</item>
    </style>
</resources>
