<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.RideAlong" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/ra_primary</item>
        <item name="colorOnPrimary">@color/ra_white</item>
        <item name="colorPrimaryContainer">@color/ra_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/ra_on_primary_container</item>
        <item name="colorSecondary">@color/ra_secondary</item>
        <item name="colorOnSecondary">@color/ra_white</item>
        <item name="colorSecondaryContainer">@color/ra_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/ra_on_secondary_container</item>
        <item name="colorTertiary">@color/ra_secondary</item>
        <item name="android:colorBackground">@color/ra_background</item>
        <item name="colorOnBackground">@color/ra_text</item>
        <item name="colorSurface">@color/ra_surface</item>
        <item name="colorOnSurface">@color/ra_text</item>
        <item name="colorSurfaceVariant">@color/ra_surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/ra_text_secondary</item>
        <item name="colorOutline">@color/ra_outline_strong</item>
        <item name="colorOutlineVariant">@color/ra_outline</item>
        <item name="colorError">@color/ra_error</item>
        <item name="colorErrorContainer">@color/ra_error_container</item>

        <item name="android:statusBarColor">@color/ra_background</item>
        <item name="android:windowLightStatusBar">@bool/ra_light_system_bars</item>
        <item name="android:navigationBarColor">@color/ra_surface</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">@bool/ra_light_system_bars</item>
        <item name="android:windowBackground">@color/ra_background</item>

        <item name="shapeAppearanceSmallComponent">@style/ShapeAppearance.RideAlong.Small</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.RideAlong.Medium</item>
        <item name="shapeAppearanceLargeComponent">@style/ShapeAppearance.RideAlong.Large</item>

        <item name="materialCardViewStyle">@style/Widget.RideAlong.Card</item>
        <item name="textInputStyle">@style/Widget.RideAlong.TextInput</item>
        <item name="materialButtonStyle">@style/Widget.RideAlong.Button</item>
        <item name="materialButtonOutlinedStyle">@style/Widget.RideAlong.Button.Outlined</item>
        <item name="toolbarStyle">@style/Widget.RideAlong.Toolbar</item>
        <item name="bottomNavigationStyle">@style/Widget.RideAlong.BottomNav</item>
        <item name="chipStyle">@style/Widget.RideAlong.Chip</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.RideAlong.Dialog</item>
        <item name="bottomSheetDialogTheme">@style/ThemeOverlay.RideAlong.BottomSheet</item>

        <item name="textAppearanceHeadlineMedium">@style/TextAppearance.RideAlong.Headline</item>
        <item name="textAppearanceTitleLarge">@style/TextAppearance.RideAlong.TitleLarge</item>
        <item name="textAppearanceTitleMedium">@style/TextAppearance.RideAlong.TitleMedium</item>
        <item name="textAppearanceBodyLarge">@style/TextAppearance.RideAlong.BodyLarge</item>
        <item name="textAppearanceBodyMedium">@style/TextAppearance.RideAlong.Body</item>
        <item name="textAppearanceBodySmall">@style/TextAppearance.RideAlong.Caption</item>
        <item name="textAppearanceLabelLarge">@style/TextAppearance.RideAlong.Label</item>
    </style>

    <style name="Theme.RideAlong.Splash" parent="Theme.RideAlong">
        <item name="android:windowBackground">@drawable/bg_splash</item>
        <item name="android:statusBarColor">@color/ra_primary</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="ThemeOverlay.RideAlong.Dialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.RideAlong.Large</item>
        <item name="colorPrimary">@color/ra_primary</item>
    </style>

    <style name="ThemeOverlay.RideAlong.BottomSheet" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/Widget.RideAlong.BottomSheet</item>
    </style>
</resources>
