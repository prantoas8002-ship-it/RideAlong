{
  "name": "ridealong-firestore-tests",
  "private": true,
  "description": "Security-rules tests and emulator-only seed data for RideAlong",
  "scripts": {
    "test": "firebase emulators:exec --only firestore --project demo-ridealong \"mocha --timeout 20000 rules.test.js\"",
    "test:running-emulator": "mocha --timeout 20000 rules.test.js",
    "seed": "node seed-emulator.js"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "3.0.4",
    "firebase": "10.14.1",
    "firebase-admin": "12.7.0",
    "firebase-tools": "13.24.2",
    "mocha": "10.8.2"
  }
}
