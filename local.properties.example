# Copy to local.properties (Android Studio creates sdk.dir automatically).
sdk.dir=/path/to/Android/Sdk

# ---- Optional ----
# Google Maps SDK key. Only used if you switch "Map provider" to Google in Settings.
# Leave empty: the app uses OpenStreetMap (osmdroid) which needs no key.
MAPS_API_KEY=
# OpenRouteService free key (https://openrouteservice.org/dev/#/signup). Empty = public OSRM server.
ORS_API_KEY=

# ---- Push relay (optional but recommended) ----
# Lets calls and notifications reach phones where RideAlong is fully closed. See push-relay/README.md
PUSH_RELAY_URL=

# ---- In-app voice calls (optional but recommended) ----
# Calls use free Google STUN servers by default. Phones on mobile data behind carrier NAT usually ALSO need
# a TURN relay. Free tiers: https://www.metered.ca/stun-turn (Open Relay) or https://www.expressturn.com
# Comma-separated URLs, e.g. turn:global.relay.metered.ca:80,turn:global.relay.metered.ca:443?transport=tcp
TURN_URLS=
TURN_USERNAME=
TURN_PASSWORD=

# ---- Development ----
# true = connect Auth + Firestore to the Firebase Emulator Suite (see SETUP_GUIDE.md)
USE_FIREBASE_EMULATOR=false
# 10.0.2.2 reaches the host machine from the Android emulator. Use your PC's LAN IP for a real device.
FIREBASE_EMULATOR_HOST=10.0.2.2
# Used only when app/google-services.json is absent: a "demo-" project works with the emulators alone.
FIREBASE_EMULATOR_PROJECT_ID=demo-ridealong

# Firebase Realtime Database URL (online / last-seen presence). Leave empty to use the default
# instance https://<project-id>-default-rtdb.firebaseio.com. If you created the database in another
# region, copy its URL from Firebase console > Realtime Database, e.g.
# https://<project-id>-default-rtdb.asia-southeast1.firebasedatabase.app
FIREBASE_DATABASE_URL=
